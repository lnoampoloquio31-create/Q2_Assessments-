# Student Score Analyzer

scores = [85, 90, 78, 92, 88]


# Function to display scores
def display_scores():
    print("\nStudent Scores:")
    for i in range(len(scores)):
        print(f"Student {i + 1}: {scores[i]}")


# Function to search for a score
def search_score():
    target = int(input("Enter the score to search: "))

    if target in scores:
        print("Score found!")
    else:
        print("Score not found.")


# Function to compute the average
def compute_average():
    average = sum(scores) / len(scores)
    print(f"Average Score: {average:.2f}")


# Function to update a score
def update_score():
    display_scores()

    index = int(input("\nEnter student number to update: "))

    if 1 <= index <= len(scores):
        new_score = int(input("Enter the new score: "))

        scores[index - 1] = new_score

        print("Score successfully updated!")
    else:
        print("Invalid student number.")


# Main program
while True:
    print("\n=== Student Score Analyzer ===")
    print("1. Display Scores")
    print("2. Search Score")
    print("3. Compute Average Score")
    print("4. Update Score")
    print("5. Display Updated Scores")
    print("6. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
      display_scores()

    elif choice == '2':
      search_score()

    elif choice == '3':
      compute_average()

    elif choice == '4':
      update_score()

    elif choice == '6':
      print("Thank you for using Student Score Analizer")
      break

    else:
      print('Invalid Score')
